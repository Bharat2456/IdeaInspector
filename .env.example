# IdeaInspector needs NO environment variables.
# Open the Dashboard -> Settings and paste your own AI provider key there (kept in your browser).
#
# OPTIONAL, for private/self-hosted use only: server-side defaults so you don't have to paste a key.
# WARNING: on a public deployment, anyone who opens the site would spend YOUR key. Leave these empty on Vercel
# unless the site is protected.
#
# LLM_PROVIDER=anthropic          # anthropic | openai  (openai = any OpenAI-compatible API)
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-6
# LLM_BASE_URL=                   # e.g. https://openrouter.ai/api/v1 for provider=openai
# LLM_MAX_TOKENS=6000
#
# PORT=3000
